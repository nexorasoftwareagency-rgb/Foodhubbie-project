+            const node = cur || resSeed;
+            if (!node || node.usedOnOrder !== String(orderId)) return undefined;
+            return { ...node, status: 'active', usedAt: null, usedOnOrder: null };
+        }).catch(() => {});
+    } catch (e) { console.error('[LOYALTY] resurrectRewardTender error:', e.message); }
