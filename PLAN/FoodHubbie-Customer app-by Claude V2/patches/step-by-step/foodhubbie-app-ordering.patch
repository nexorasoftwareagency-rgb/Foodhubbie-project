+    const pickupReady = order.orderMode === 'pickup' && status === 'Ready'
+        ? '<div class="trk-otp">Your order is ready — please collect it at the counter.</div>' : '';
+    return `<ol class="trk-steps">${dots}</ol>${rider}${otp}${pickupReady}`;
+}
