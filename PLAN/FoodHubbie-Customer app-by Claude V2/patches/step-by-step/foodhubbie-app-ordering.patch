+// Live tracking for the dedicated app: steps differ for delivery and pickup.
+const TRACK_DELIVERY = [['Placed', 'Placed'], ['Confirmed', 'Confirmed'], ['Ready', 'Ready'], ['Out for Delivery', 'On the way'], ['Delivered', 'Delivered']];
