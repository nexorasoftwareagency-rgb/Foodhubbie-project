 docs/PLAN-DEDICATED-CUSTOMER-APP.md |  8 +++++++-
 tests/direct-mode.check.mjs         | 22 ++++++++++++++++++++++
 2 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/docs/PLAN-DEDICATED-CUSTOMER-APP.md b/docs/PLAN-DEDICATED-CUSTOMER-APP.md
index 3e2d3d4..cdfa943 100644
--- a/docs/PLAN-DEDICATED-CUSTOMER-APP.md
