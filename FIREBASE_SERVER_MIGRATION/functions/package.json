{
  "name": "foodhubbie-functions",
  "version": "1.0.0",
  "description": "Foodhubbie Firebase Functions 2nd Gen - Meta WhatsApp Cloud API Backend",
  "main": "lib/index.js",
  "scripts": {
    "build": "node scripts/copy-vendor.cjs && tsc",
    "build:watch": "tsc -w",
    "vendor": "node scripts/copy-vendor.cjs",
    "check:vendor": "node scripts/copy-vendor.cjs --check",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "deploy": "firebase deploy --only functions",
    "deploy:staging": "firebase deploy --only functions --project foodhubbie-staging",
    "deploy:prod": "firebase deploy --only functions --project foodhubbie-prod",
    "logs": "firebase functions:log --project foodhubbie-prod",
    "logs:staging": "firebase functions:log --project foodhubbie-staging",
    "emulator": "firebase emulators:start --only functions,firestore,database",
    "emulator:functions": "firebase emulators:start --only functions",
    "test:health": "npm run build && node scripts/health-selfcheck.cjs",
    "cost:check": "node scripts/cost-check.js",
    "deploy:verify": "node scripts/verify-deployment.js"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@google-cloud/monitoring": "^5.0.0",
    "@google-cloud/secret-manager": "^5.0.0",
    "@google-cloud/tasks": "^5.0.0",
    "axios": "^1.6.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^6.0.0",
    "google-auth-library": "^11.3.3",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "firebase-functions-test": "^3.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.5"
  }
}
