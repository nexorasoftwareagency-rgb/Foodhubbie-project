{
  "scripts": {
    "build": "node tools/build.mjs",
    "build:admin": "node tools/build.mjs --admin",
    "build:supreme": "node tools/build.mjs --supreme",
    "build:demo-site": "node tools/build-demo-site.mjs",
    "deploy:admin": "npm run build:admin && firebase deploy --only hosting:admin",
    "deploy:supreme": "npm run build:supreme && firebase deploy --only hosting:supreme",
    "deploy:website": "npm run build:admin && npm run build:demo-site && firebase deploy --only hosting:website",
    "test": "playwright test",
    "test:encoding": "node tests/encoding-check.mjs",
    "test:demo": "node tests/demo-e2e.mjs",
    "check:demo-nav": "node tools/check-demo-nav.cjs",
    "test:isolation": "node tests/phase5-rider-isolation.check.cjs && node tests/phase5-rules-isolation.check.cjs",
    "seo:check-domain": "node tools/check-domain-migration.cjs",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "chart.js": "^4.4.1",
    "playwright": "^1.61.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.1",
    "purgecss": "^8.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
